  "shortcuts": [
    { "name": "Iniciar corrida (cronômetro)", "short_name": "Iniciar corrida", "description": "Começa a cronometrar a corrida e a contar os km pelo GPS", "url": "./ridemax.html?app=1&atalho=corrida", "icons": [{ "src": "atalho-corrida.png?v=2", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Iniciar ou encerrar turno", "short_name": "Turno", "description": "Abre o turno pedindo só o odômetro (ou encerra o turno aberto)", "url": "./ridemax.html?app=1&atalho=turno", "icons": [{ "src": "atalho-turno.png?v=2", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Nova corrida rápida", "short_name": "+ Corrida", "description": "Lança uma corrida já feita, só com plataforma e valor", "url": "./ridemax.html?app=1&rapida=1", "icons": [{ "src": "atalho-rapida.png?v=2", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Lançar despesa", "short_name": "Despesa", "description": "Abre o formulário de despesa", "url": "./ridemax.html?app=1&atalho=despesa", "icons": [{ "src": "atalho-despesa.png?v=2", "sizes": "192x192", "type": "image/png" }] }
  ]
